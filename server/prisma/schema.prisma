generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String

  // One user can have many resumes
  resumes   Resume[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Resume {
  id              String   @id @default(cuid())

  title           String
  summary         String?

  education       Json?
  experience      Json?
  skills          Json?
  projects        Json?
  certifications  Json?
  languages       Json?

  template        String   @default("modern")

  userId          String
  user            User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}